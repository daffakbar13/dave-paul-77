{
  "name": "dave-paul-77-server",
  "version": "0.1.0",
  "private": true,
  "description": "Express + MongoDB API for the D1 support/resistance trading helper: analysis, orders, command queue for the MT4/MT5 EAs.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "dev:memory": "node --env-file-if-exists=.env scripts/dev-memory.ts",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "seed": "node --env-file-if-exists=.env scripts/seed.ts",
    "sync:engine": "node scripts/sync-engine.ts",
    "hash-password": "node scripts/hash-password.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "mongodb-memory-server": "^11.3.0",
    "typescript": "~5.9.3"
  }
}

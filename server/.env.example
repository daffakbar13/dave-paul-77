PORT=4000
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_DB=dave_paul_77
JWT_SECRET=change-me-long-random-string
# bcrypt hash of the web password: npm run hash-password -- 'your password'
ADMIN_PASSWORD_HASH=
# key the MT4 data EA sends in X-Api-Key
EA_DATA_KEY=change-me
# comma-separated web origins (Vercel domain)
CORS_ORIGIN=http://localhost:5173
# economic calendar: forexfactory (free, current week), worker (the Cloudflare news worker), sample or none
NEWS_SOURCE=forexfactory
# for NEWS_SOURCE=worker: the worker URL, e.g. https://dave-paul-77-news.<account>.workers.dev
NEWS_WORKER_URL=
